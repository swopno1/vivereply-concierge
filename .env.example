# Vivereply Concierge — environment template.
# Copy to .env.local for local dev, or set each in Vercel → Project →
# Settings → Environment Variables for deploys. NEVER commit real values:
# no .env* file belongs in git, and secret VALUES never travel over chat —
# names only. Every variable below is read by the code (audited); anything
# else is cruft and does not belong here.

# --- Answering model: Muse Spark via the Meta Model API (primary, always) ---
# Key starts with LLM_, shown once — store it in a password manager.
META_API_KEY=
# Provider endpoint + agent model. Defaults work (https://api.meta.ai/v1,
# muse-spark-1.3); set only to point elsewhere.
META_API_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3
# Sampling knob (optimization backlog #1): 0-2, e.g. 0.2 for steadier
# tool-use. Unset = API default = today's behavior. Invalid values warn
# and behave as unset. Decided by eval runs, recorded in docs/decision-log.md.
# META_TEMPERATURE=

# --- Fallback backend: Baseten-hosted Muse Spark Open (optional) ------------
# Retried once, with the identical payload, when the Meta API errors
# (hackathon demo insurance). Inert when unset. The key works ONLY with
# meta-models/muse-spark-open-1026 (pinned in lib/meta.ts — there is no
# override). Guest text flows to Baseten on fallback turns.
# BASETEN_API_KEY=

# --- Embeddings ONLY (answering stays Muse Spark) ---------------------------
# Google AI Studio key, gemini-embedding-001 at 768 dims. Used by chat
# grounding, the knowledge seeder, and (from Modal Secrets, not here)
# the onboarding worker.
GEMINI_API_KEY=

# --- Database: Supabase Postgres via Prisma ---------------------------------
# DATABASE_URL = transaction pooler URI (port 6543) — the app at runtime.
# DIRECT_URL = session/direct URI (port 5432) — migrations + `db push`
# via prisma.config.ts. Paste both from Supabase Dashboard → Project
# Settings → Database. Raw TCP must reach Supabase (sandboxed shells
# cannot — run db commands from an open machine).
DATABASE_URL=
DIRECT_URL=

# --- Demo wiring + tenant registration --------------------------------------
# SUITE_API_BASE_URL = fallback booking backend for the demo property
# (demo1 deployment). Properties WITH a binding row use their own URL.
SUITE_API_BASE_URL=https://demo1.vivereply.com
# Slug of the demo property (matches its Property row + catalogue file).
DEMO_PROPERTY_ID=krishnachura-retreat
# NOTE: seed-tenant owner passwords live INLINE in
# prisma/seed-tenants.mjs (ownerPassword per entry) — there are no
# TENANT_PASSWORD_* env vars. Test tenants only; details plus the
# security contract in docs/seed-users.md.

# --- Logins + sessions -------------------------------------------------------
# ADMIN_EMAIL + ADMIN_PASSWORD = founder bootstrap login (super-admin).
# Checked first, so recovery is unconditional even if User rows break.
# Unset ADMIN_EMAIL disables the bootstrap (fail closed). Never reuse
# ADMIN_EMAIL for a User row (seed or register UI) — the bootstrap
# shadows it. Recovery for a locked-out team is changing these.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# SESSION_SECRET signs sessions + chat/widget/embed tokens (random, at
# least 16 chars). Unset in production fails login AND chat closed —
# never a dev fallback there.
SESSION_SECRET=

# --- Suite binding keys at rest ----------------------------------------------
# Encrypts per-property backend keys (AES-256-GCM, lib/secrets.ts).
# Random string, at least 32 chars. Without it, bindings cannot store
# keys and keyed backends fail closed.
# Rotation rule: safe to (re)generate ONLY while no bindings exist (an
# empty DB). Once a keyed binding is stored, changing this makes every
# stored secret unreadable — rotation then means re-entering each key.
BINDING_SECRET_KEY=

# --- RAG onboarding (Next.js side) -------------------------------------------
# SUPABASE_URL + SERVICE key sign Storage upload/download URLs (server
# only — never the anon key, never the browser). WORKER_SHARED_SECRET is
# the app↔worker credential (random 32+ chars, same value in the Modal
# Secret below). MODAL_WORKER_URL is the deployed Modal webhook; without
# it, runs wait queued and /invoke retries later.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
WORKER_SHARED_SECRET=
MODAL_WORKER_URL=

# --- Modal Secret `vivereply-onboarding` (NOT .env — Modal dashboard) --------
# The ingestion worker reads these from its Modal Secret, never from this
# repo's environment. Set via `modal secret create` (see worker/README.md):
#   APP_BASE_URL         public app URL (worker calls back here)
#   WORKER_SHARED_SECRET same value as above (both directions)
#   GEMINI_API_KEY       same embeddings key as above
#   WORKER_DB_URL        least-privilege role URL (docs/worker-db-role.sql),
#                        NEVER the service key — the worker bypasses nothing
# Rotation rule: Modal values are COPIES, not links. Rotating
# WORKER_SHARED_SECRET or GEMINI_API_KEY here means deleting + recreating
# the Modal Secret too, or app and worker silently disagree. No redeploy
# of the worker is needed afterwards (secrets resolve by name per run).

# --- Eval runner (terminal only — never Vercel) ------------------------------
# `pnpm eval` logs in as the fixture owner and replays the 12 cases
# against EVAL_BASE_URL. EVAL_PASSWORD is that owner's CURRENT password
# (the seed env at seed time, or whatever it was changed to since).
# EVAL_EMAIL / EVAL_BASE_URL have defaults (sabreeze@test.com,
# https://app.vivereply.com); set only to point elsewhere, e.g. local dev.
# EVAL_EMAIL=
# EVAL_BASE_URL=
EVAL_PASSWORD=

# --- Public signup: email + spam defense --------------------------------------
# RESEND_API_KEY + RESEND_FROM send the verification emails (lib/email.ts).
# RESEND_FROM must be on a VERIFIED domain in production (DNS) — Resend's
# onboarding sender only reaches the account's own inbox.
# TURNSTILE_SECRET_KEY verifies human checks server-side; the public site
# key below ships in the client bundle (NEXT_PUBLIC_ prefix required).
# Signup fails CLOSED without the secret; login skips with an alarm.
# Cloudflare's documented test keys (always pass, dev only):
#   site: 1x00000000000000000000AA / secret: 1x0000000000000000000000000000000AA
# APP_BASE_URL (optional) overrides the verification-link host; unset it
# falls back to the request origin (correct on Vercel).
RESEND_API_KEY=
RESEND_FROM=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAAAFrmCwI561EwAdCj"
# APP_BASE_URL=
# APP_BASE_URL is REQUIRED for booking payments (and recommended anyway):
# payment deep links are built ONLY from this canonical origin, never from
# request headers. Production value: https://app.vivereply.com

# --- Booking payments (OFF by default — suite users only) --------------------
# The chatbot insists on payment for held drafts and mints /pay/[token]
# deep links; guests pay via Stripe Checkout or manual transfer.
# Suite-only: fixture properties never get payment tools, even when on.
# PAYMENTS_ENABLED=true
# STRIPE_SECRET_KEY= (restricted key rk_…, test mode first; card method
#   appears in chat only when set — manual transfer always available)
# STRIPE_WEBHOOK_SECRET= (whsec_… from the webhook endpoint below)
# PAYMENT_LINK_TTL_HOURS= (default 24, max 72 — mirrors the hold window)
# MANUAL_PAYMENT_INSTRUCTIONS= (default text in lib/payments.ts; keep it
#   generic until per-property instructions ship — never a fake number)
# Stripe webhook endpoint to register (test mode, then live):
#   https://app.vivereply.com/api/pay/webhook  (event: checkout.session.completed)

# Per-tenant chat throttle: max turns per minute per property (DB-backed
# fixed windows; 429 + Retry-After past the cap). 0 disables (local dev).
# CHAT_RATE_LIMIT_PER_MIN= (default 60)
# Per-IP second dimension: one address can't spend a whole property's
# budget. Same shape, same 429. 0 disables.
# CHAT_RATE_LIMIT_IP_PER_MIN= (default 30)

# --- Isolation probes (terminal only — never Vercel) -------------------------
# `pnpm probes` replays the 10 cross-tenant tests. A = mutating test
# tenant (seabreeze), B = read-only reference (krishnachura). A-owner id
# comes from SQL: SELECT id FROM "User" WHERE email='sabreeze@test.com';
# PROBE_BASE_URL= (default https://app.vivereply.com)
# PROBE_A_PROPERTY= (default seabreeze-test)
# PROBE_A_EMAIL= (default sabreeze@test.com)
PROBE_A_PASSWORD=
# PROBE_A_KEY= (default test-seabreeze)
PROBE_A_OWNER_ID=
# PROBE_B_PROPERTY= (default krishnachura-retreat)
# PROBE_B_EMAIL= (default krishnachura@test.com)
PROBE_B_PASSWORD=
# PROBE_B_KEY= (default demo-krishnachura)
# PROBE_B_DOMAIN= (default demo1.vivereply.com)
PROBE_ADMIN_EMAIL=
PROBE_ADMIN_PASSWORD=

# --- Client dashboard variable (NOT ours — the client's server) --------------
# Settings → Staff bridge codes reference CONCIERGE_BRIDGE_KEY as the
# conventional name for the bridge key on the CLIENT's server. It is
# minted in our Settings, shown once, and must never reach a browser.
# Nothing in this repo reads it.
