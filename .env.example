# Vivereply Concierge — environment template.
# Copy to .env.local for local dev, or set each in Vercel → Project →
# Settings → Environment Variables for deploys. NEVER commit real values:
# no .env* file belongs in git, and secret VALUES never travel over chat —
# names only. Every variable below is read by the code (audited); anything
# else is cruft and does not belong here.

# --- Answering model: Muse Spark via the Meta Model API (primary, always) ---
# Key starts with LLM_, shown once — store it in a password manager.
META_API_KEY=
# Provider endpoint + agent model. Defaults work (https://api.meta.ai/v1,
# muse-spark-1.3); set only to point elsewhere.
META_API_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3

# --- Fallback backend: Baseten-hosted Muse Spark Open (optional) ------------
# Retried once, with the identical payload, when the Meta API errors
# (hackathon demo insurance). Inert when unset. The key works ONLY with
# meta-models/muse-spark-open-1026 (pinned in lib/meta.ts — there is no
# override). Guest text flows to Baseten on fallback turns.
# BASETEN_API_KEY=

# --- Embeddings ONLY (answering stays Muse Spark) ---------------------------
# Google AI Studio key, gemini-embedding-001 at 768 dims. Used by chat
# grounding, the knowledge seeder, and (from Modal Secrets, not here)
# the onboarding worker.
GEMINI_API_KEY=

# --- Database: Supabase Postgres via Prisma ---------------------------------
# DATABASE_URL = transaction pooler URI (port 6543) — the app at runtime.
# DIRECT_URL = session/direct URI (port 5432) — migrations + `db push`
# via prisma.config.ts. Paste both from Supabase Dashboard → Project
# Settings → Database. Raw TCP must reach Supabase (sandboxed shells
# cannot — run db commands from an open machine).
DATABASE_URL=
DIRECT_URL=

# --- Demo wiring + tenant registration --------------------------------------
# SUITE_API_BASE_URL = fallback booking backend for the demo property
# (demo1 deployment). Properties WITH a binding row use their own URL.
SUITE_API_BASE_URL=https://demo1.vivereply.com
# Slug of the demo property (matches its Property row + catalogue file).
DEMO_PROPERTY_ID=krishnachura-retreat
# Owner passwords for `pnpm seed:tenants` — ONLY in the seeder's
# environment, min 12 chars each. One per TENANTS entry in
# prisma/seed-tenants.mjs: TENANT_PASSWORD_<SLUG>, slug uppercased,
# dashes to underscores. Never committed, never in Vercel.
# TENANT_PASSWORD_KRISHNACHURA_RETREAT=
# TENANT_PASSWORD_SEABREEZE_TEST=

# --- Logins + sessions -------------------------------------------------------
# ADMIN_EMAIL + ADMIN_PASSWORD = founder bootstrap login (super-admin).
# Checked first, so recovery is unconditional even if User rows break.
# Unset ADMIN_EMAIL disables the bootstrap (fail closed). Never reuse
# ADMIN_EMAIL for a User row (seed or register UI) — the bootstrap
# shadows it. Recovery for a locked-out team is changing these.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# SESSION_SECRET signs sessions + chat/widget/embed tokens (random, at
# least 16 chars). Unset in production fails login AND chat closed —
# never a dev fallback there.
SESSION_SECRET=

# --- Suite binding keys at rest ----------------------------------------------
# Encrypts per-property backend keys (AES-256-GCM, lib/secrets.ts).
# Random string, at least 32 chars. Without it, bindings cannot store
# keys and keyed backends fail closed.
BINDING_SECRET_KEY=

# --- RAG onboarding (Next.js side) -------------------------------------------
# SUPABASE_URL + SERVICE key sign Storage upload/download URLs (server
# only — never the anon key, never the browser). WORKER_SHARED_SECRET is
# the app↔worker credential (random 32+ chars, same value in the Modal
# Secret below). MODAL_WORKER_URL is the deployed Modal webhook; without
# it, runs wait queued and /invoke retries later.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
WORKER_SHARED_SECRET=
MODAL_WORKER_URL=

# --- Modal Secret `vivereply-onboarding` (NOT .env — Modal dashboard) --------
# The ingestion worker reads these from its Modal Secret, never from this
# repo's environment. Set via `modal secret create` (see worker/README.md):
#   APP_BASE_URL         public app URL (worker calls back here)
#   WORKER_SHARED_SECRET same value as above (both directions)
#   GEMINI_API_KEY       same embeddings key as above
#   WORKER_DB_URL        least-privilege role URL (docs/worker-db-role.sql),
#                        NEVER the service key — the worker bypasses nothing

# --- Client dashboard variable (NOT ours — the client's server) --------------
# Settings → Staff bridge codes reference CONCIERGE_BRIDGE_KEY as the
# conventional name for the bridge key on the CLIENT's server. It is
# minted in our Settings, shown once, and must never reach a browser.
# Nothing in this repo reads it.
