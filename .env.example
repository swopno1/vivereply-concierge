# Copy to .env and fill in. NEVER commit .env.
# Meta Model API (key starts with LLM_, shown once — store in a password manager)
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3
# Optional fallback: Baseten-hosted Muse Spark Open, retried once when the
# Meta API errors (hackathon demo insurance). Inert when unset. The key
# works ONLY with meta-models/muse-spark-open-1026 (pinned in lib/meta.ts).
# Guest text flows to Baseten on fallback turns.
# BASETEN_API_KEY=
# Suite API base for the demo property (demo1 deployment)
SUITE_API_BASE_URL=https://demo1.vivereply.com
# Shared secret for agent endpoints (generate a random string)
AGENT_SHARED_SECRET=
# Demo property (fictional demo config, no real guest data)
DEMO_PROPERTY_ID=krishnachura-retreat
# Demo payments only — never real money in this repo's demo
PAYMENT_MODE=simulate
# Supabase Postgres — paste from Project Settings → Database in your dashboard:
# DATABASE_URL = Transaction pooler URI (port 6543, for the app at runtime)
# DIRECT_URL = Direct connection URI (port 5432, for migrations / db push)
DATABASE_URL=
DIRECT_URL=
# Gemini embeddings ONLY (step 3 RAG retrieval — the answering model stays
# Muse Spark via the Meta Model API). Create in Google AI Studio, put in
# .env.local, never commit it.
GEMINI_API_KEY=
# Security layer (step 4.5) — set both in the deployment environment,
# never in the repo. ADMIN_PASSWORD is the single admin password for
# /login (protects /staff and /admin). SESSION_SECRET signs admin
# sessions and chat tokens (random, at least 16 characters). Without
# SESSION_SECRET in production, login and chat fail closed.
ADMIN_PASSWORD=
SESSION_SECRET=
# Suite adapter (Phase 2) — encrypts per-property backend keys at rest
# (AES-256-GCM via lib/secrets.ts). Random string, at least 32 characters.
# Without it, bindings cannot store keys and keyed backends fail closed.
BINDING_SECRET_KEY=
# RAG onboarding — Supabase project URL + SERVICE key (server only, signs
# Storage upload/download URLs; never the anon key, never in the browser),
# the shared worker secret (Bearer both directions, random 32+ chars), and
# the deployed Modal webhook URL. Without the worker URL, runs wait queued.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
WORKER_SHARED_SECRET=
MODAL_WORKER_URL=
# Tenant seed passwords — ONLY in the seeder's environment when running
# `pnpm seed:tenants` (min 12 chars each). One per TENANTS entry in
# prisma/seed-tenants.mjs: TENANT_PASSWORD_<SLUG>, slug uppercased,
# dashes to underscores. Never committed, never in Vercel.
# TENANT_PASSWORD_KRISHNACHURA_RETREAT=
# TENANT_PASSWORD_SEABREEZE_TEST=
