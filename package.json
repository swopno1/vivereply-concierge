{
  "name": "vivereply-concierge",
  "version": "0.1.0",
  "private": true,
  "author": "ViveScript Solutions",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "seed:tenants": "node prisma/seed-tenants.mjs",
    "eval": "node --no-warnings --experimental-transform-types --loader ./scripts/esm-alias-loader.mjs eval/run.mjs",
    "eval:dashboard": "node eval/dashboard.mjs",
    "probes": "node probes/run.mjs",
    "funnel": "node eval/funnel.mjs",
    "test": "node --no-warnings --experimental-transform-types --loader ./scripts/esm-alias-loader.mjs --test \"tests/*.test.mjs\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "18.0.9",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "tsx": "4.23.15"
  }
}
