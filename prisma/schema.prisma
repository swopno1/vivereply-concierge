// Concierge's own schema (step 2a). Suite data is referenced by ID only —
// never joined across databases. Knowledge tables arrive with step 3 (RAG).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model Conversation {
  id         String         @id @default(cuid())
  propertyId String
  language   String         @default("en")
  status     String         @default("OPEN")
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  messages   Message[]
  toolCalls  ToolCallLog[]
  handoffs   HandoffRecord[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model ToolCallLog {
  id               String       @id @default(cuid())
  conversationId   String
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  toolName         String
  input            Json?
  output           Json?
  promptTokens     Int?
  completionTokens Int?
  reasoningTokens  Int?
  createdAt        DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model HandoffRecord {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  reason         String
  summary        String
  status         String       @default("OPEN")
  createdAt      DateTime     @default(now())
}

model PropertyBinding {
  id           String   @id @default(cuid())
  workspaceId  String   @unique
  propertyId   String
  suiteBaseUrl String
  secretRef    String
  createdAt    DateTime @default(now())
}

model KnowledgeDocument {
  id        String           @id @default(cuid())
  title     String
  source    String           @default("demo-seed")
  content   String
  createdAt DateTime         @default(now())
  chunks    KnowledgeChunk[]
}

model KnowledgeChunk {
  id         String            @id @default(cuid())
  documentId String
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  content    String
  embedding  Unsupported("vector(768)")
  createdAt  DateTime          @default(now())

  @@index([documentId])
}

// Approved widget hosts (step 4.5). A domain here, still active, is
// the only thing that lets a site embed the widget for that property.
// Hostnames are exact (lowercased, no scheme, no port). Admins manage
// rows in /admin; there is no user table in v1 (single admin via
// ADMIN_PASSWORD env, see lib/auth.ts).
model ApprovedDomain {
  id         String   @id @default(cuid())
  domain     String
  propertyId String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([domain, propertyId])
  @@index([propertyId, active])
}
