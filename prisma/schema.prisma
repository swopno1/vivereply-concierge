// Concierge's own schema (step 1b). Suite data is referenced by ID only —
// never joined across databases. Knowledge tables arrive with step 3 (RAG).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Conversation {
  id         String       @id @default(cuid())
  propertyId String
  language   String       @default("en")
  status     String       @default("OPEN")
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  messages   Message[]
  toolCalls  ToolCallLog[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model ToolCallLog {
  id               String       @id @default(cuid())
  conversationId   String
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  toolName         String
  input            Json?
  output           Json?
  promptTokens     Int?
  completionTokens Int?
  reasoningTokens  Int?
  createdAt        DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model PropertyBinding {
  id           String   @id @default(cuid())
  workspaceId  String   @unique
  propertyId   String
  suiteBaseUrl String
  secretRef    String
  createdAt    DateTime @default(now())
}
