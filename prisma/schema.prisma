// Concierge's own schema (step 2a). Suite data is referenced by ID only —
// never joined across databases. Knowledge tables arrive with step 3 (RAG).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Tenant registry (multi-tenant core). One row per resort. The id is the
// property slug (e.g. krishnachura-retreat) matching the propertyId strings
// already stored across tables. Rows are created by public signup
// (/api/auth/signup: Property + OWNER + verification token, one tx) or,
// for test tenants only, the seed file (prisma/seed-tenants.mjs).
// widgetKey is the public embed key (see demo-config/widget-keys.ts).
model Property {
  id                 String              @id
  name               String
  widgetKey          String              @unique
  // Owner linkage for the Scale 3-property limit (Phase 3 fix): the
  // owner email this property was created for (signup email / admin
  // ownerEmail), set on EVERY creation. Pre-fix rows carry NULL and
  // link through their owner User row instead (see
  // countPropertiesForOwner). Never used for login — identity stays
  // on the User row; this field only answers "how many properties
  // does this owner have?".
  ownerEmail         String?
  status             String              @default("ACTIVE")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  users              User[]
  // Tenancy hub (Phase 1): every tenant table FKs here. Deletes cascade
  // except AuditLog (Restrict — the trail goes only by explicit delete;
  // see the offboarding runbook, which deletes children first anyway).
  conversations      Conversation[]
  bridgeTokens       BridgeToken[]
  roomMappings       RoomMapping[]
  binding            PropertyBinding?
  knowledgeDocuments KnowledgeDocument[]
  profile            PropertyProfile?
  onboardingRun      OnboardingRun?
  approvedDomains    ApprovedDomain[]
  rateBuckets        RateBucket[]
  widgetOpens        WidgetOpen[]
  auditLogs          AuditLog[]
  subscription       Subscription?
  billingNotices     BillingNotice[]

  @@index([ownerEmail])
}

// Credentialed logins (multi-tenant core). Roles: SUPER_ADMIN (the founder,
// sees every property) and OWNER (sees exactly one property). OWNER rows
// come from public signup (email verification + Turnstile) or, for test
// tenants only, the seed file (inline test passwords, committed
// deliberately — see docs/seed-users.md). passwordHash is scrypt (see
// lib/auth.ts). A SUPER_ADMIN row has null propertyId; an OWNER row must
// have one, and login fails closed if the property is missing or inactive.
model User {
  id                 String                   @id @default(cuid())
  email              String                   @unique
  passwordHash       String
  role               String
  propertyId         String?
  property           Property?                @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  // D1 dashboard switcher: the property this owner last opened. Plain id,
  // no FK — validated (exists, ACTIVE, owned) every time it is used, so a
  // stale or revoked value fails closed back to propertyId. Survives
  // sign-out; login prefers it over propertyId when valid.
  lastPropertyId     String?
  active             Boolean                  @default(true)
  // True while a temporary (seed-issued) password is in force — the owner
  // sees a change-password banner until they set their own.
  mustChangePassword Boolean                  @default(false)
  // Null until the owner proves the email (self-signup link). Seed
  // owners are attested: verified at creation. Config surfaces
  // (Settings, onboarding, their APIs) require this.
  emailVerifiedAt    DateTime?
  // TOTP 2FA: secret encrypted with lib/secrets (BINDING_SECRET_KEY),
  // set at setup-init, enforced only once enabledAt is set (setup
  // completes on a correct code). Null secret = 2FA off.
  totpSecretEnc      String?
  totpEnabledAt      DateTime?
  createdAt          DateTime                 @default(now())
  sessions           Session[]
  verificationTokens EmailVerificationToken[]
  resetTokens        PasswordResetToken[]
  recoveryCodes      RecoveryCode[]

  @@index([propertyId, active])
}

// 2FA recovery codes: one-time, scrypt-hashed (never plaintext),
// single-use via usedAt (claimed atomically). Shown once at setup
// confirm; a code that is used or superseded never works again.
model RecoveryCode {
  id        String    @id @default(cuid())
  codeHash  String
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Server-side session allowlist (auth Tier 1). The cookie still carries a
// signed payload (fast gating), but a session is live ONLY while its row
// exists, is unrevoked, unexpired, and within the idle window. Logout,
// password change, and admin revoke all act here — no more "rotate the
// global secret to kill one session". Bootstrap (env-password) super-admin
// sessions have a null userId. Rows are small; prune expired ones
// opportunistically at login.
model Session {
  id         String    @id @default(cuid())
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       String
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([userId, revokedAt])
}

// Login attempt log (auth Tier 1 throttling). One row per login POST (both
// outcomes). Throttle reads recent failures per email / per IP; rows older
// than an hour are pruned opportunistically at login. No passwords here,
// ever — only the outcome.
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String
  ok        Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

// Email-verification tokens (public signup). Random 32-byte token, SHA-256
// hash at rest (raw value travels only inside the emailed link), 24h
// expiry, single use (usedAt). Resending invalidates older unused tokens
// for the user so only the newest link works.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Password-reset tokens (public reset, Phase 0). Same shape as
// EmailVerificationToken: random 32-byte token, SHA-256 hash at rest
// (raw value travels only inside the emailed link), 1h expiry,
// single use (usedAt). A new request invalidates older unused tokens
// for the user so only the newest link works.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Signup attempt log (spam defense). Mirrors LoginAttempt: signup is
// throttled per email + per IP, DB-backed so it holds across instances.
// No passwords here, ever — only the outcome.
model SignupAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String
  ok        Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

model Conversation {
  id         String          @id @default(cuid())
  propertyId String
  property   Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  language   String          @default("en")
  status     String          @default("OPEN")
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  messages   Message[]
  toolCalls  ToolCallLog[]
  handoffs   HandoffRecord[]
  rating     ChatRating?
  draftClaim DraftClaim?

  @@index([propertyId, createdAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  author         String?
  content        String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model ToolCallLog {
  id               String       @id @default(cuid())
  conversationId   String
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  toolName         String
  input            Json?
  output           Json?
  promptTokens     Int?
  completionTokens Int?
  reasoningTokens  Int?
  createdAt        DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model HandoffRecord {
  id             String        @id @default(cuid())
  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  reason         String
  summary        String
  status         String        @default("OPEN")
  assignee       String?
  guestPhone     String?
  guestEmail     String?
  createdAt      DateTime      @default(now())
  notes          HandoffNote[]
}

// Staff follow-up notes on a handoff (bridge API). Written by client
// dashboards through server-to-server calls, never by the chat agent.
model HandoffNote {
  id        String        @id @default(cuid())
  handoffId String
  handoff   HandoffRecord @relation(fields: [handoffId], references: [id], onDelete: Cascade)
  author    String
  body      String
  createdAt DateTime      @default(now())

  @@index([handoffId, createdAt])
}

// Server-to-server bridge credentials (one per client dashboard
// integration). Only the secret's hash is stored — a stolen database
// row cannot call the API. The full token is shown once, at mint time,
// and never again. Revoking (active = false) kills the key on its next
// call, because every bridge request re-checks the row.
model BridgeToken {
  id         String   @id @default(cuid())
  prefix     String   @unique
  secretHash String
  name       String
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([propertyId, active])
}

// One booking backend per property (Suite adapter). secretEnc holds the
// backend's bearer key AES-GCM encrypted (see lib/secrets.ts) — the plain
// secret is never stored and never leaves the server. One binding per
// property; lastTestedAt records the newest Test connection result.
// One catalogue row per room per property (Suite adapter). The demo
// catalogue file seeds these rows; afterwards the database governs for
// any property that has rows, and the file remains the fallback only for
// the demo property until it is seeded.
model RoomMapping {
  id              String   @id @default(cuid())
  propertyId      String
  property        Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  slug            String
  name            String
  basePricePoisha Int
  suiteRoomId     String
  highlights      String[]
  createdAt       DateTime @default(now())

  @@unique([propertyId, slug])
  @@index([propertyId])
}

model PropertyBinding {
  id             String    @id @default(cuid())
  workspaceId    String?   @unique
  propertyId     String    @unique
  property       Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  suiteBaseUrl   String
  secretEnc      String?
  // The resort's OWN payment page (owner-configured, https). The bot
  // deep-links here with ?booking=CODE after a draft — "showing the
  // cash counter". Concierge never takes resort money itself; unset =
  // the bot says to pay on the resort site / offers a handoff.
  paymentPageUrl String?
  version        Int       @default(1)
  lastTestedAt   DateTime?
  lastTestOk     Boolean?
  createdAt      DateTime  @default(now())
}

model KnowledgeDocument {
  id         String           @id @default(cuid())
  // NULL = platform corpus (R1 Lane A: ViveReply knowledge, readable by
  // all tenants via the marked service path). Property writers must still
  // pass an explicit propertyId — see the ingestion guards, not the type.
  propertyId String?
  property   Property?        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  title      String
  source     String           @default("demo-seed")
  content    String
  createdAt  DateTime         @default(now())
  chunks     KnowledgeChunk[]

  @@index([propertyId])
}

// Business profile captured at onboarding: facts + the reply identity
// (assistant name, tone, languages, greeting) the property wants.
model PropertyProfile {
  id                 String   @id @default(cuid())
  propertyId         String   @unique
  property           Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  businessName       String
  address            String?
  phone              String?
  email              String?
  website            String?
  assistantName      String?
  tone               String?
  languages          String[]
  greeting           String?
  // Suggestion segments the owner enabled at onboarding (ids from
  // lib/segments.ts). The agent may advise ONLY on these, and only
  // from verified property information — never general knowledge.
  suggestionSegments String[] @default([])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// One ingestion run per property (RAG onboarding). Status: PENDING (queued,
// worker not finished), RUNNING, COMPLETE, PARTIAL (budget abort, with
// stats), FAILED. A second run is rejected unless approvedRerun was flipped
// by an admin — the flip is consumed by the next submit.
model OnboardingRun {
  id            String    @id @default(cuid())
  propertyId    String    @unique
  property      Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  status        String    @default("PENDING")
  filePaths     String[]
  website       String?
  stats         Json?
  error         String?
  approvedRerun Boolean   @default(false)
  approvedBy    String?
  approvedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model KnowledgeChunk {
  id         String                     @id @default(cuid())
  documentId String
  document   KnowledgeDocument          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  content    String
  // Visibility switch (worker rework): the worker stages chunks unindexed
  // and flips its job's chunks on clean completion, so guests never see a
  // half-ingested run. Default true so existing rows and seed scripts stay
  // live with no backfill — the worker always sets false explicitly.
  indexed    Boolean                    @default(true)
  embedding  Unsupported("vector(768)")
  createdAt  DateTime                   @default(now())

  @@index([documentId])
}

// Approved widget hosts (step 4.5). A domain here, still active, is
// the only thing that lets a site embed the widget for that property.
// Hostnames are exact (lowercased, no scheme, no port). Admins manage
// rows in /admin; there is no user table in v1 (single admin via
// ADMIN_PASSWORD env, see lib/auth.ts).
model ApprovedDomain {
  id         String   @id @default(cuid())
  domain     String
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([domain, propertyId])
  @@index([propertyId, active])
}

// Guest booking payments (suite users only, flag-gated). One row per
// payment link the chatbot mints for a held draft: the token is the
// unguessable /pay/[token] URL, the amount is snapshotted server-side
// from the draft (never from the browser), and the 24h expiry mirrors
// the booking hold. Guest contact is a snapshot for the receipt only —
// the /pay page shows the first name, never email or phone.

// Guest helpful vote (one-tap post-chat rating). One row per
// conversation (upsert — the guest may change their mind). No PII of
// its own: the conversation link carries the context, and the chat
// token gates the write exactly like a chat message.
model ChatRating {
  id             String       @id @default(cuid())
  conversationId String       @unique
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  helpful        Boolean
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// Per-tenant chat throttle (noisy-neighbour guard): fixed one-minute
// windows, one row per property per window. DB-backed, not in-memory —
// serverless instances share nothing, so only the database counts
// globally. Best-effort prune of old windows rides on the check.
model RateBucket {
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  windowStart DateTime
  count       Int      @default(1)

  @@id([propertyId, windowStart])
  @@index([windowStart])
}

// Per-IP chat throttle: the second dimension. The per-property bucket
// guards neighbours from each other; this one guards the shared model
// budget from one bot hammering a single property. Same fixed windows,
// same DB-backed atomic upsert. IPv6 addresses fit (45 chars max).
model IpRateBucket {
  ip          String   @db.VarChar(80)
  windowStart DateTime
  count       Int      @default(1)

  @@id([ip, windowStart])
  @@index([windowStart])
}

// Draft claim (double-draft race guard): at most one row per
// conversation, held only across the check→book window (claimed
// before suite.createBooking, released in a finally right after).
// A crash between claim and release leaves a stale row — claims
// older than 5 minutes are pruned on the next denied claim, so the
// guest's retry succeeds. Cascades with the conversation.
model DraftClaim {
  conversationId String       @unique
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
}

// Widget opens (funnel stage zero): one row per panel open, fired by
// widget.js via sendBeacon. Property + timestamp ONLY — no IP, no
// user agent, no guest identity. Unauthenticated by design (a guest
// action); abuse pollutes metrics, never data. Powers the funnel's
// open-to-chat conversion; prune freely past the pilot window.
model WidgetOpen {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([propertyId, createdAt])
}

// Admin audit trail (append-only in practice; nothing deletes these
// rows except tenant offboarding). actorEmail is whoever acted (or
// the attempted email on login failure); detail carries names/ids/
// outcomes only — never secrets, hashes, or keys.
model AuditLog {
  id         String    @id @default(cuid())
  actorEmail String?
  action     String
  propertyId String?
  // Restrict, not Cascade: the trail goes only by explicit delete (the
  // offboarding runbook deletes audit rows before the property, so the
  // runbook order proves this end to end). A Property delete that skips
  // the runbook fails loudly instead of vaporizing history.
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  detail     Json?
  ip         String?
  createdAt  DateTime  @default(now())

  @@index([createdAt])
  @@index([propertyId, createdAt])
}

// Subscription billing (Phase 3 — resorts paying US via Stripe).
// One row per property, created WITH the property (signup + admin
// create): status TRIAL, tier GROWTH (trial runs full Growth
// features), trialEndsAt = created + 30 days, no Stripe ids yet (no
// card at signup). Properties WITHOUT a row (demo, seeds, anything
// predating Phase 3) are grandfathered: full access, no trial clock.
// Statuses: TRIAL → ACTIVE (Checkout) → PAST_DUE (failed invoice,
// still served while Stripe retries) → CANCELED (ended or ending —
// cancelAtPeriodEnd serves to currentPeriodEnd) / EXPIRED (trial ran
// out unpaid, or subscription deleted). tier/interval mirror the
// Stripe subscription (webhook-synced); overageAgreed is the future
// opt-in past 120% (no UI until metered billing ships — stays false).
model Subscription {
  id                   String    @id @default(cuid())
  propertyId           String    @unique
  property             Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tier                 String    @default("GROWTH")
  interval             String    @default("MONTHLY")
  status               String    @default("TRIAL")
  trialEndsAt          DateTime
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  overageAgreed        Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

// Billing notice log (trial reminders + usage alerts). The cron
// endpoint sends each (property, kind, period) exactly once: trial
// kinds use period "trial" (TRIAL_DAY7/21/27/30, TRIAL_EXPIRED),
// usage kinds the UTC month ("2026-11": USAGE_80, PAYMENT_FAILED).
// Reading this table is how "already reminded?" is answered — the
// send + insert run in one transaction, so a crash retries cleanly.
model BillingNotice {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  kind       String
  periodKey  String
  sentAt     DateTime @default(now())

  @@unique([propertyId, kind, periodKey])
  @@index([propertyId, sentAt])
}

// Stripe webhook idempotency (service-only: RLS enabled with NO
// tenant policy, so only the bypass role touches it). The Stripe
// event id IS the primary key — a redelivered event conflicts on
// insert and answers 200 without re-applying.
model StripeEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())
}

// R1 Lane A misses: questions the platform corpus could not answer.
// Service-only like StripeEvent (see prisma/sql/r1-assistant-rls.sql);
// the super-admin unanswered list reads them. propertyId records where
// the question was asked (nullable: brand scope has none).
model AssistantUnanswered {
  id         String   @id @default(cuid())
  question   String
  lang       String   @default("en")
  propertyId String?
  createdAt  DateTime @default(now())
  resolvedAt DateTime?

  @@index([resolvedAt, createdAt])
}
