// Concierge's own schema (step 2a). Suite data is referenced by ID only —
// never joined across databases. Knowledge tables arrive with step 3 (RAG).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

// Tenant registry (multi-tenant core). One row per resort. The id is the
// property slug (e.g. krishnachura-retreat) matching the propertyId strings
// already stored across tables. Rows are created by public signup
// (/api/auth/signup: Property + OWNER + verification token, one tx) or,
// for test tenants only, the seed file (prisma/seed-tenants.mjs).
// widgetKey is the public embed key (see demo-config/widget-keys.ts).
model Property {
  id        String   @id
  name      String
  widgetKey String   @unique
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
}

// Credentialed logins (multi-tenant core). Roles: SUPER_ADMIN (the founder,
// sees every property) and OWNER (sees exactly one property). OWNER rows
// come from public signup (email verification + Turnstile) or, for test
// tenants only, the seed file (inline test passwords, committed
// deliberately — see docs/seed-users.md). passwordHash is scrypt (see
// lib/auth.ts). A SUPER_ADMIN row has null propertyId; an OWNER row must
// have one, and login fails closed if the property is missing or inactive.
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         String
  propertyId   String?
  property     Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  active       Boolean   @default(true)
  // True while a temporary (seed-issued) password is in force — the owner
  // sees a change-password banner until they set their own.
  mustChangePassword Boolean @default(false)
  // Null until the owner proves the email (self-signup link). Seed
  // owners are attested: verified at creation. Config surfaces
  // (Settings, onboarding, their APIs) require this.
  emailVerifiedAt DateTime?
  createdAt    DateTime  @default(now())
  sessions     Session[]
  verificationTokens EmailVerificationToken[]

  @@index([propertyId, active])
}

// Server-side session allowlist (auth Tier 1). The cookie still carries a
// signed payload (fast gating), but a session is live ONLY while its row
// exists, is unrevoked, unexpired, and within the idle window. Logout,
// password change, and admin revoke all act here — no more "rotate the
// global secret to kill one session". Bootstrap (env-password) super-admin
// sessions have a null userId. Rows are small; prune expired ones
// opportunistically at login.
model Session {
  id        String    @id @default(cuid())
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String
  createdAt DateTime  @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([userId, revokedAt])
}

// Login attempt log (auth Tier 1 throttling). One row per login POST (both
// outcomes). Throttle reads recent failures per email / per IP; rows older
// than an hour are pruned opportunistically at login. No passwords here,
// ever — only the outcome.
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String
  ok        Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

// Email-verification tokens (public signup). Random 32-byte token, SHA-256
// hash at rest (raw value travels only inside the emailed link), 24h
// expiry, single use (usedAt). Resending invalidates older unused tokens
// for the user so only the newest link works.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Signup attempt log (spam defense). Mirrors LoginAttempt: signup is
// throttled per email + per IP, DB-backed so it holds across instances.
// No passwords here, ever — only the outcome.
model SignupAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String
  ok        Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

model Conversation {
  id         String         @id @default(cuid())
  propertyId String
  language   String         @default("en")
  status     String         @default("OPEN")
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  messages   Message[]
  toolCalls  ToolCallLog[]
  handoffs   HandoffRecord[]
  paymentLinks PaymentLink[]
  rating     ChatRating?
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model ToolCallLog {
  id               String       @id @default(cuid())
  conversationId   String
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  toolName         String
  input            Json?
  output           Json?
  promptTokens     Int?
  completionTokens Int?
  reasoningTokens  Int?
  createdAt        DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model HandoffRecord {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  reason         String
  summary        String
  status         String       @default("OPEN")
  assignee       String?
  createdAt      DateTime     @default(now())
  notes          HandoffNote[]
}

// Staff follow-up notes on a handoff (bridge API). Written by client
// dashboards through server-to-server calls, never by the chat agent.
model HandoffNote {
  id        String        @id @default(cuid())
  handoffId String
  handoff   HandoffRecord @relation(fields: [handoffId], references: [id], onDelete: Cascade)
  author    String
  body      String
  createdAt DateTime      @default(now())

  @@index([handoffId, createdAt])
}

// Server-to-server bridge credentials (one per client dashboard
// integration). Only the secret's hash is stored — a stolen database
// row cannot call the API. The full token is shown once, at mint time,
// and never again. Revoking (active = false) kills the key on its next
// call, because every bridge request re-checks the row.
model BridgeToken {
  id         String   @id @default(cuid())
  prefix     String   @unique
  secretHash String
  name       String
  propertyId String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([propertyId, active])
}

// One booking backend per property (Suite adapter). secretEnc holds the
// backend's bearer key AES-GCM encrypted (see lib/secrets.ts) — the plain
// secret is never stored and never leaves the server. One binding per
// property; lastTestedAt records the newest Test connection result.
// One catalogue row per room per property (Suite adapter). The demo
// catalogue file seeds these rows; afterwards the database governs for
// any property that has rows, and the file remains the fallback only for
// the demo property until it is seeded.
model RoomMapping {
  id              String   @id @default(cuid())
  propertyId      String
  slug            String
  name            String
  basePricePoisha Int
  suiteRoomId     String
  highlights      String[]
  createdAt       DateTime @default(now())

  @@unique([propertyId, slug])
  @@index([propertyId])
}

model PropertyBinding {
  id            String    @id @default(cuid())
  workspaceId   String?   @unique
  propertyId    String    @unique
  suiteBaseUrl  String
  secretEnc     String?
  version       Int       @default(1)
  lastTestedAt  DateTime?
  lastTestOk    Boolean?
  createdAt     DateTime  @default(now())
}

model KnowledgeDocument {
  id         String           @id @default(cuid())
  propertyId String           @default("krishnachura-retreat")
  title      String
  source     String           @default("demo-seed")
  content    String
  createdAt  DateTime         @default(now())
  chunks     KnowledgeChunk[]

  @@index([propertyId])
}

// Business profile captured at onboarding: facts + the reply identity
// (assistant name, tone, languages, greeting) the property wants.
model PropertyProfile {
  id            String   @id @default(cuid())
  propertyId    String   @unique
  businessName  String
  address       String?
  phone         String?
  email         String?
  website       String?
  assistantName String?
  tone          String?
  languages     String[]
  greeting      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// One ingestion run per property (RAG onboarding). Status: PENDING (queued,
// worker not finished), RUNNING, COMPLETE, PARTIAL (budget abort, with
// stats), FAILED. A second run is rejected unless approvedRerun was flipped
// by an admin — the flip is consumed by the next submit.
model OnboardingRun {
  id            String    @id @default(cuid())
  propertyId    String    @unique
  status        String    @default("PENDING")
  filePaths     String[]
  website       String?
  stats         Json?
  error         String?
  approvedRerun Boolean   @default(false)
  approvedBy    String?
  approvedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model KnowledgeChunk {
  id         String            @id @default(cuid())
  documentId String
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  content    String
  // Visibility switch (worker rework): the worker stages chunks unindexed
  // and flips its job's chunks on clean completion, so guests never see a
  // half-ingested run. Default true so existing rows and seed scripts stay
  // live with no backfill — the worker always sets false explicitly.
  indexed    Boolean           @default(true)
  embedding  Unsupported("vector(768)")
  createdAt  DateTime          @default(now())

  @@index([documentId])
}

// Approved widget hosts (step 4.5). A domain here, still active, is
// the only thing that lets a site embed the widget for that property.
// Hostnames are exact (lowercased, no scheme, no port). Admins manage
// rows in /admin; there is no user table in v1 (single admin via
// ADMIN_PASSWORD env, see lib/auth.ts).
model ApprovedDomain {
  id         String   @id @default(cuid())
  domain     String
  propertyId String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([domain, propertyId])
  @@index([propertyId, active])
}

// Guest booking payments (suite users only, flag-gated). One row per
// payment link the chatbot mints for a held draft: the token is the
// unguessable /pay/[token] URL, the amount is snapshotted server-side
// from the draft (never from the browser), and the 24h expiry mirrors
// the booking hold. Guest contact is a snapshot for the receipt only —
// the /pay page shows the first name, never email or phone.
model PaymentLink {
  id             String    @id @default(cuid())
  propertyId     String
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  bookingCode    String
  method         String // "stripe" | "manual"
  token          String    @unique
  amountPoisha   Int
  currency       String    @default("bdt")
  status         String    @default("pending") // pending|paid|expired|canceled
  stripeSessionId String?  @unique
  guestEmail     String?
  guestFirstName String?
  guestName      String?
  room           String?
  checkIn        String?
  checkOut       String?
  manualReference String?
  paidAt         DateTime?
  expiresAt      DateTime
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([propertyId, status])
  @@index([conversationId])
  @@index([bookingCode])
}

// Guest helpful vote (one-tap post-chat rating). One row per
// conversation (upsert — the guest may change their mind). No PII of
// its own: the conversation link carries the context, and the chat
// token gates the write exactly like a chat message.
model ChatRating {
  id             String   @id @default(cuid())
  conversationId String   @unique
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  helpful        Boolean
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Per-tenant chat throttle (noisy-neighbour guard): fixed one-minute
// windows, one row per property per window. DB-backed, not in-memory —
// serverless instances share nothing, so only the database counts
// globally. Best-effort prune of old windows rides on the check.
model RateBucket {
  propertyId  String
  windowStart DateTime
  count       Int      @default(1)

  @@id([propertyId, windowStart])
  @@index([windowStart])
}

// Per-IP chat throttle: the second dimension. The per-property bucket
// guards neighbours from each other; this one guards the shared model
// budget from one bot hammering a single property. Same fixed windows,
// same DB-backed atomic upsert. IPv6 addresses fit (45 chars max).
model IpRateBucket {
  ip          String   @db.VarChar(80)
  windowStart DateTime
  count       Int      @default(1)

  @@id([ip, windowStart])
  @@index([windowStart])
}

// Admin audit trail (append-only in practice; nothing deletes these
// rows except tenant offboarding). actorEmail is whoever acted (or
// the attempted email on login failure); detail carries names/ids/
// outcomes only — never secrets, hashes, or keys.
model AuditLog {
  id         String   @id @default(cuid())
  actorEmail String?
  action     String
  propertyId String?
  detail     Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([propertyId, createdAt])
}
